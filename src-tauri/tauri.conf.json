{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionForge",
  "version": "0.1.20",
  "identifier": "com.sessionforge.desktop",
  "build": {
    "frontendDist": "../src-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SessionForge",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/session-forge-engine"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}