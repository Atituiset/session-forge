{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SessionForge",
  "version": "0.3.0",
  "identifier": "com.sessionforge.desktop",
  "build": {
    "frontendDist": "../src-web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SessionForge",
        "width": 1360,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDU5Q0JCRENFRTkwQTM5MUQKUldRZE9RcnB6cjNMV1NoYjZscXJPMTd4NVlZN2FETTdQQ2hxcWd1cmJwWkJIRFhLcjRzdGJJZDUK",
      "endpoints": [
        "https://github.com/Atituiset/session-forge/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "dmg",
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "externalBin": [
      "binaries/session-forge-engine"
    ],
    "resources": {
      "binaries/session-forge-linux-x64-agent": "resources/session-forge-linux-x64-agent"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": [
          "SimpChinese",
          "English"
        ]
      }
    }
  }
}