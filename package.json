{
  "name": "session-forge",
  "version": "0.1.27",
  "description": "The session hub for AI coding agents — every CLI, every machine, one searchable memory. Relay sessions between agents mid-task.",
  "keywords": [
    "claude-code",
    "codex",
    "ai-agents",
    "llm",
    "coding-assistant",
    "session-management",
    "knowledge-management",
    "developer-tools",
    "wsl",
    "ssh",
    "cli",
    "tauri"
  ],
  "license": "MIT",
  "author": "Atituiset",
  "repository": {
    "type": "git",
    "url": "https://github.com/Atituiset/session-forge.git"
  },
  "homepage": "https://github.com/Atituiset/session-forge",
  "type": "module",
  "bin": {
    "session-forge": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "build": "bun build --compile src/cli.ts --outfile dist/session-forge",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build"
  },
  "dependencies": {
    "agent-session-format": "^0.2.0",
    "commander": "^15.0.0",
    "ssh2": "^1.17.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.11.4",
    "@types/bun": "^1.4.0",
    "@types/ssh2": "^1.15.5",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2"
  }
}
